checksum=47ec02be6c0a6323044600a9221b049f63e1953faf816903e7383d4dc4234487

post_install() {
	vlicense LICENSE
}

libspng-devel_package() {
	depends="libspng>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include/spng.h
		vmove usr/lib/pkgconfig/spng.pc
	}
}
