do_build() {	make CC="$CC" \
	CFLAGS="$CFLAGS $(pkg-config --cflags wayland-client pixman-1)" \
	LDFLAGS="$LDFLAGS" \
	PREFIX=/usr prefix=/usr \
	${makejobs} ${make_build_args} ${make_build_target}
}
