_commit="6a928895864f766363cf3b6ad851d9efd8e85335"
distfiles="https://git.sr.ht/~shrub900/${pkgname}/archive/${_commit}.tar.gz"
checksum=c42f7289d3629527b5353bb5cc76977a2f7b9fd3cc524ef09496613fc0995236

post_install() {
	vlicense LICENSE
}

neuswc-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/libswc.a
		vmove usr/lib/pkgconfig
		vcopy build/protocol/*.h usr/include
	}
}
