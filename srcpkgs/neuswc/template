revision=1
build_style=meson
configure_args="-Db_lundef=false"
hostmakedepends="pkg-config"
makedepends="wayland-devel expat-devel libdrm-devel neuwld pixman-devel wayland-protocols fontconfig-devel libxkbcommon-devel libinput-devel libxcb-devel xcb-util-wm-devel xorg-server-xwayland"
depends="neuwld wayland-protocols xorg-server-xwayland"
